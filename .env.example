# Server-only runtime origin. Use HTTPS outside local development.
APP_URL=http://localhost:5000
DATABASE_PATH=./data/crashguard.sqlite
# Optional override for the passkey origin; defaults to APP_URL.
# Use a stable HTTPS origin in production. localhost supports HTTP for development.
# AUTH_ORIGIN=http://localhost:5000
# Envelope limit: 25 MB; individual error events: 1 MB. 120 requests/project/minute.
INGEST_RATE_LIMIT=120

# Optional Docker Compose settings (used with --env-file .env.local).
# This is a HOST directory; Docker always uses /app/data/crashguard.sqlite inside.
CRASHGUARD_DATA_DIR=./data
CRASHGUARD_PORT=5000
CRASHGUARD_BIND_ADDRESS=127.0.0.1
# Match the owner of the host data directory (id -u and id -g on Linux/WSL).
CRASHGUARD_UID=1000
CRASHGUARD_GID=1000
# Optional native minidump processing; set automatically by compose.native.yaml.
# SYMBOLICATOR_URL=http://localhost:3021
# SYMBOLICATOR_SOURCES=[]
# Exact hostnames permitted for webhooks on private networks (comma-separated).
# ALERT_WEBHOOK_HOSTS=alerts.internal.example
