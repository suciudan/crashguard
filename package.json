{
  "name": "crashguard-lite",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 5000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 5000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:sdk": "tsx scripts/test-sdk.ts",
    "test:telemetry": "tsx scripts/test-telemetry-sdk.ts",
    "test:operations": "tsx scripts/test-operations.ts",
    "test:replay": "tsx scripts/test-replay-isolation.ts",
    "test:native": "tsx scripts/test-native.ts",
    "test:browser": "tsx scripts/test-browser.ts",
    "test:links": "tsx scripts/test-links.ts",
    "test:passkeys": "tsx scripts/test-passkeys.ts",
    "auth:reset": "node --env-file-if-exists=.env.local scripts/reset-passkeys.mjs"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@sentry/browser": "^10.75.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "better-sqlite3": "13.0.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rrweb": "^2.1.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@sentry/node": "latest",
    "@sentry/profiling-node": "^10.75.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
